{
  "name": "obsidian-simple-memo",
  "version": "1.0.9",
  "private": true,
  "description": "A local, membership-free memo plugin with Thino daily-note compatibility",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:vault": "node --import tsx scripts/check-vault.ts",
    "lint": "eslint src",
    "check:release": "node scripts/validate-release.mjs",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "moment": "^2.30.1",
    "obsidian": "^1.8.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitxinyu/obsidian-simple-memo.git"
  },
  "bugs": {
    "url": "https://github.com/bitxinyu/obsidian-simple-memo/issues"
  },
  "homepage": "https://github.com/bitxinyu/obsidian-simple-memo#readme"
}
